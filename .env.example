# 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
# 1단계(추천·순위)는 키 없이 동작합니다. 아래 값은 2단계(뉴스 수집·AI 요약·질문하기)부터 사용합니다.
#
# 주의: NEXT_PUBLIC_ 으로 시작하는 변수는 브라우저로 노출됩니다. 비밀 키에는 절대 붙이지 마세요.
# 아래 키들은 서버 코드(src/app/api, scripts)에서만 process.env 로 읽습니다.

# AI 요약·질문하기 (Anthropic Claude)
ANTHROPIC_API_KEY=

# 뉴스·동향 저장 DB (Supabase Postgres)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 매일 수집 작업(cron) 호출을 보호하는 비밀 값
CRON_SECRET=
